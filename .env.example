# Copy this file to .env (git ignores .env) and fill in your key. Never commit a real key.

# Claude API key from https://platform.claude.com - lets Specter, Analyst and Oracle use their models.
# Without it Phantom still runs its static checks and the sandbox.
ANTHROPIC_API_KEY=

# anthropic (default) | scripted (canned answers from PHANTOM_MODEL_SCRIPT, for demos/tests) | none
# PHANTOM_MODEL_PROVIDER=anthropic

# One model per layer, deeper and slower from top to bottom. Change freely.
# PHANTOM_SPECTER_MODEL=claude-haiku-5-5
# PHANTOM_SPECTER_EFFORT=low
# PHANTOM_ANALYST_MODEL=claude-sonnet-5-5
# PHANTOM_ANALYST_EFFORT=medium
# PHANTOM_ORACLE_MODEL=claude-fable-5-1
# PHANTOM_ORACLE_EFFORT=high
