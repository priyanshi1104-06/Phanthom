{
  // F5 with "Phanthom: backend + extension" starts the backend and a second VS Code window
  // (the "Extension Development Host") with the extension loaded and samples/ open.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Phanthom backend",
      "type": "debugpy",
      "request": "launch",
      "module": "backend",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONDONTWRITEBYTECODE": "1" },
      "subProcess": false,
      "justMyCode": true
    },
    {
      "name": "Phanthom extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension", "${workspaceFolder}/samples"],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "Compile extension"
    }
  ],
  "compounds": [
    {
      "name": "Phanthom: backend + extension",
      "configurations": ["Phanthom backend", "Phanthom extension"],
      "stopAll": true
    }
  ]
}
